rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to users collection for unauthenticated email lookup during forgot password
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
